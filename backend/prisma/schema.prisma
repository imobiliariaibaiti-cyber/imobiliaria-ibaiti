generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Property {
  id              Int      @id @default(autoincrement())
  propertyCode    String?
  title           String
  type            String
  city            String
  cityDescription String?
  address         String?
  latitude        Float?
  longitude       Float?
  areaSize        String?
  price           BigInt
  description     String
  deedAndRegistryOk Boolean @default(false)
  featured        Boolean  @default(false)
  images          Json
  videoUrl        String?
  comments        Comment[]
  visits          Visit[]
  createdAt       DateTime @default(now())
}

model Comment {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])
  name       String
  contact    String?
  rating     Int      @default(5)
  text       String
  status     CommentStatus @default(PENDING)
  createdAt  DateTime @default(now())
}

model Visit {
  id         Int       @id @default(autoincrement())
  path       String
  propertyId Int?
  property   Property? @relation(fields: [propertyId], references: [id])
  referrer   String?
  userAgent  String?
  source     String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([propertyId])
}

model CitySummary {
  id         Int      @id @default(autoincrement())
  city       String   @unique
  summary    String?
  population Int?
  rating     Float?
  lat        Float?
  lng        Float?
  fetchedAt  DateTime @default(now())
}

model ClientUser {
  id            Int              @id @default(autoincrement())
  name          String
  email         String           @unique
  phone         String
  passwordHash  String
  hasAccount    Boolean          @default(false)
  properties    ClientProperty[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ClientProperty {
  id                 Int                  @id @default(autoincrement())
  clientUserId       Int
  clientUser         ClientUser           @relation(fields: [clientUserId], references: [id])
  title              String
  type               String
  city               String
  address            String?
  latitude           Float?
  longitude          Float?
  areaSize           String?
  priceExpectation   BigInt?
  description        String
  documentStatus     String
  deedAndRegistryOk  Boolean             @default(false)
  images             Json
  videoUrl           String?
  status             ClientPropertyStatus @default(PENDING_REVIEW)
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([clientUserId])
  @@index([status])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClientPropertyStatus {
  DRAFT
  PENDING_REVIEW
  IN_REVIEW
  APPROVED
  REJECTED
}

